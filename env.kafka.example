# Kafka Configuration
# Replace with your actual Kafka broker addresses
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic configuration
KAFKA_TOPIC=candidate-invitation
KAFKA_GROUP_ID=candidate-invitation-consumer

# Consumer configuration
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true

# Database configuration (keep your existing database settings)
# DATABASE_URL=postgresql://user:password@localhost:5432/themus
# etc.
